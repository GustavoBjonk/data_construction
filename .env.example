# URL pública usada em canonical, sitemap, Open Graph e links de e-mail de autenticação.
# Em desenvolvimento local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://dataconstruction.vercel.app

# Supabase (Project Settings → API). A chave publicável é segura no navegador:
# a proteção dos dados vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contas e login (/entrar, /cadastro, /conta). Desligado por padrão:
# sem "true" essas rotas respondem 404 e o site não faz nenhuma chamada ao Supabase,
# mesmo que as chaves acima estejam preenchidas.
NEXT_PUBLIC_AUTH_ENABLED=false

# Origem do conteúdo público: "static" (arquivos JSON de content/, padrão) ou "supabase".
# Só mude para "supabase" depois de aplicar migrações + seed e validar o banco.
CONTENT_SOURCE=static

# --- Monetização (tudo desligado por padrão; ver docs/monetizacao.md) ---
# Google AdSense — dois estados separados:
#   Verificação: só o Publisher ID (ca-pub- + 16 dígitos, copiado do painel do AdSense).
#                Publica a metatag google-adsense-account e o /ads.txt; não carrega anúncios.
#   Veiculação:  ENABLED=true, somente após a aprovação do site no AdSense e com hospedagem comercial.
#                Só vale em deploy de Production. IDs de bloco ficam em content/settings/ads.json.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Anúncios automáticos do Google (também precisam ser ligados no painel). Exige ENABLED=true.
NEXT_PUBLIC_ADSENSE_AUTO_ADS=false
# Mostra as posições reservadas (somente fora de Production), sem carregar anúncios.
NEXT_PUBLIC_ADSENSE_PREVIEW=false

# Programa de Associados da Amazon: a mesma tag dos links de content/afiliados/livros.json.
# Confirme no painel do Amazon Associates que o domínio do site está cadastrado.
# O aviso de afiliados em Termos/Privacidade/Cookies também liga sozinho se houver link ativo.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=pautaliberdade-20

# E-mail de contato exibido nas páginas legais (exigido pela LGPD antes de ativar anúncios ou contas).
# PENDENTE: preencher com o e-mail real antes de ativar anúncios ou contas.
NEXT_PUBLIC_CONTACT_EMAIL=

# NUNCA defina aqui a service role key com prefixo NEXT_PUBLIC_.
